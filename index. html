<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>InfraAgent AI | Sovereign Infrastructure</title>
    <style>
        :root {
            --bg: #020617;
            --hex-bg: #0f172a;
            --accent: #3b82f6;
            --accent-glow: rgba(59, 130, 246, 0.5);
            --text-main: #f8fafc;
            --text-dim: #94a3b8;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { 
            background-color: var(--bg); 
            color: var(--text-main); 
            font-family: 'Inter', system-ui, sans-serif; 
            padding: 20px; 
            display: flex; 
            flex-direction: column; 
            align-items: center;
            overflow-x: hidden;
        }

        /* PREMIUM GLOW BACKGROUND */
        body::before {
            content: ""; position: fixed; top: -10%; left: -10%; width: 40%; height: 40%;
            background: radial-gradient(circle, var(--accent-glow) 0%, transparent 70%);
            z-index: -1; filter: blur(80px); opacity: 0.3;
        }

        header { text-align: center; margin: 60px 0 40px; }
        .brand { font-size: 2.8rem; font-weight: 900; text-transform: uppercase; letter-spacing: -2px; font-style: italic; color: #fff; line-height: 1; }
        .tagline { color: var(--accent); font-size: 0.7rem; font-weight: 800; letter-spacing: 0.5em; text-transform: uppercase; margin-top: 10px; }

        .container { width: 100%; max-width: 480px; display: flex; flex-direction: column; gap: 40px; }

        /* THE HEXAGONAL CARD STYLE */
        .hexa-card {
            background: var(--hex-bg);
            border: 1px solid rgba(59, 130, 246, 0.2);
            position: relative;
            padding: 40px 30px;
            clip-path: polygon(10% 0, 90% 0, 100% 20%, 100% 80%, 90% 100%, 10% 100%, 0 80%, 0 20%);
            box-shadow: 0 20px 40px rgba(0,0,0,0.4);
        }

        .hexa-card::after {
            content: ""; position: absolute; top: 0; left: 0; right: 0; bottom: 0;
            border: 1px solid var(--accent);
            clip-path: polygon(10% 0, 90% 0, 100% 20%, 100% 80%, 90% 100%, 10% 100%, 0 80%, 0 20%);
            pointer-events: none; opacity: 0.3;
        }

        h2 { font-size: 1.2rem; font-weight: 800; text-transform: uppercase; letter-spacing: 2px; margin-bottom: 15px; text-align: center; color: var(--accent); }
        p.desc { font-size: 0.85rem; color: var(--text-dim); text-align: center; margin-bottom: 25px; line-height: 1.5; }

        /* PRODUCT BUTTON */
        .btn-blueprint {
            display: block; width: 100%; background: var(--accent); color: white;
            text-decoration: none; text-align: center; padding: 20px; font-weight: 900;
            text-transform: uppercase; letter-spacing: 2px; font-size: 0.9rem;
            clip-path: polygon(5% 0, 95% 0, 100% 50%, 95% 100%, 5% 100%, 0 50%);
            transition: all 0.3s ease;
        }
        .btn-blueprint:hover { transform: scale(1.02); filter: brightness(1.2); }

        /* FORM NODES */
        .form-group { margin-bottom: 25px; border-bottom: 1px solid rgba(255,255,255,0.05); padding-bottom: 15px; }
        label { display: block; font-size: 0.65rem; font-weight: 800; color: var(--accent); text-transform: uppercase; margin-bottom: 10px; letter-spacing: 1px; }
        input, select {
            width: 100%; background: transparent; border: none; color: #fff;
            font-size: 1rem; font-weight: 500; outline: none; padding: 5px 0;
        }
        input::placeholder { color: #334155; }

        .protocol-toggle { display: flex; align-items: center; gap: 15px; background: rgba(59, 130, 246, 0.05); padding: 15px; border-radius: 4px; }
        .protocol-toggle input { width: 22px; height: 22px; cursor: pointer; accent-color: var(--accent); }
        .protocol-toggle span { font-size: 0.7rem; color: var(--text-dim); line-height: 1.3; }

        /* FINAL VERIFICATION TRIGGER */
        .btn-verify {
            width: 100%; padding: 25px; background: #fff; color: #000;
            border: none; font-weight: 900; text-transform: uppercase;
            letter-spacing: 4px; cursor: pointer; font-size: 1rem;
            clip-path: polygon(5% 0, 95% 0, 100% 50%, 95% 100%, 5% 100%, 0 50%);
            margin-top: 20px;
        }

        footer { margin-top: 80px; padding: 40px 0; border-top: 1px solid #1e293b; width: 100%; text-align: center; }
        .footer-creds { font-size: 9px; color: #475569; letter-spacing: 4px; text-transform: uppercase; }
        .system-status { font-size: 9px; color: #22c55e; margin-top: 10px; text-transform: uppercase; letter-spacing: 2px; }
    </style>
</head>
<body>

    <header>
        <p class="tagline">Sovereign Architect</p>
        <div class="brand">InfraAgent AI</div>
    </header>

    <div class="container">
        
        <div class="hexa-card">
            <h2>The Sovereign Blueprint</h2>
            <p class="desc">High-intent architecture for autonomous n8n workflows and 2048-bit RSA hardened environments.</p>
            <a href="YOUR_DODO_LINK_HERE" class="btn-blueprint">Purchase Blueprint</a>
        </div>

        <div class="hexa-card" style="border-top: 2px solid var(--accent);">
            <h2>Mission Verification</h2>
            <form action="YOUR_N8N_WEBHOOK_URL" method="POST">
                
                <div class="form-group">
                    <label>01. Monthly Inefficiency Leakage</label>
                    <input type="text" name="leakage" placeholder="e.g. $1,200/mo" required>
                </div>

                <div class="form-group">
                    <label>02. Infrastructure Grade</label>
                    <select name="grade" required>
                        <option value="" disabled selected>Select Grade</option>
                        <option value="Grade I">Grade I (Foundational)</option>
                        <option value="Grade II">Grade II (Hardened Stack)</option>
                        <option value="Grade III">Grade III (Full Agentic Oracle)</option>
                    </select>
                </div>

                <div class="protocol-toggle">
                    <input type="checkbox" name="compliance" required>
                    <span>Authorize transition to 2048-bit RSA Sovereign Infrastructure Protocol.</span>
                </div>

                <div class="form-group" style="margin-top: 25px;">
                    <label>04. Designated Mission Budget</label>
                    <select name="budget" required>
                        <option value="" disabled selected>Select Range</option>
                        <option value="1250-3500">$1,250 - $3,500</option>
                        <option value="3500-10000">$3,500 - $10,000</option>
                        <option value="10000+">$10,000+</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>05. Final Sovereign Decision Maker</label>
                    <input type="text" name="decision_maker" placeholder="Full Name & Title" required>
                </div>

                <button type="submit" class="btn-verify">Verify Mission</button>
            </form>
        </div>

    </div>

    <footer>
        <div class="footer-creds">UDYAM-PB-11-0050125 | IEC BRJPS8738J | INFRAAGENT AI</div>
        <div class="system-status">● Solana Mainnet: Connected via Alchemy</div>
    </footer>

</body>
</html>
